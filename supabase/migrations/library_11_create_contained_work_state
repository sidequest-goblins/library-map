-- ============================================================
-- MyLibrary: per-reader progress for contained omnibus works
-- ============================================================
--
-- Work IDs come from LIBRARY WORKS.xlsx.
-- The workbook describes what a physical volume contains.
-- Supabase describes what an individual reader has done with it.
--
-- No row is treated by the app as "Not started".
-- An explicit unread row is also allowed so tracked state can be reset.
-- ============================================================

create table if not exists public.library_reader_contained_work_state (
  user_id uuid not null
    references auth.users(id)
    on delete cascade,

  reader_id text not null,
  work_id text not null,

  status text not null default 'unread',

  current_page integer,

  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now(),

  constraint library_reader_contained_work_state_reader_check
    check (
      reader_id in ('cj', 'jc')
    ),

  constraint library_reader_contained_work_state_work_id_check
    check (
      work_id ~
        '^work-[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$'
    ),

  constraint library_reader_contained_work_state_status_check
    check (
      status in (
        'unread',
        'in_progress',
        'paused',
        'read'
      )
    ),

  constraint library_reader_contained_work_state_page_check
    check (
      current_page is null
      or current_page >= 0
    ),

  constraint library_reader_contained_work_state_primary_key
    primary key (
      user_id,
      reader_id,
      work_id
    )
);

create or replace function
  public.set_library_reader_contained_work_state_updated_at()
returns trigger
language plpgsql
as $$
begin
  new.updated_at = now();
  return new;
end;
$$;

drop trigger if exists
  set_library_reader_contained_work_state_updated_at
  on public.library_reader_contained_work_state;

create trigger
  set_library_reader_contained_work_state_updated_at
before update
on public.library_reader_contained_work_state
for each row
execute function
  public.set_library_reader_contained_work_state_updated_at();

-- ============================================================
-- Permissions and Row Level Security
-- ============================================================

alter table
  public.library_reader_contained_work_state
enable row level security;

revoke all
on table
  public.library_reader_contained_work_state
from anon;

revoke all
on table
  public.library_reader_contained_work_state
from authenticated;

grant select, insert, update
on table
  public.library_reader_contained_work_state
to authenticated;

drop policy if exists
  "Users can read their contained work state"
  on public.library_reader_contained_work_state;

create policy
  "Users can read their contained work state"
on public.library_reader_contained_work_state
for select
to authenticated
using (
  (select auth.uid()) = user_id
);

drop policy if exists
  "Users can insert their contained work state"
  on public.library_reader_contained_work_state;

create policy
  "Users can insert their contained work state"
on public.library_reader_contained_work_state
for insert
to authenticated
with check (
  (select auth.uid()) = user_id
);

drop policy if exists
  "Users can update their contained work state"
  on public.library_reader_contained_work_state;

create policy
  "Users can update their contained work state"
on public.library_reader_contained_work_state
for update
to authenticated
using (
  (select auth.uid()) = user_id
)
with check (
  (select auth.uid()) = user_id
);

-- There is intentionally no DELETE permission.
-- "Not started" can be represented by status = 'unread'.

