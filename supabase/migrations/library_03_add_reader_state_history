-- ============================================================
-- MyLibrary 03 - Add Reader State History
--
-- Creates:
--   1. An append-only audit/history table.
--   2. A protected trigger function outside the exposed schema.
--   3. Automatic history capture for INSERT, UPDATE, and DELETE.
--   4. A baseline snapshot of all existing reader-state rows.
--
-- Browser permissions:
--   authenticated household user: SELECT only
--   anon: no access
--   browser INSERT / UPDATE / DELETE: prohibited
-- ============================================================


-- ------------------------------------------------------------
-- 1. Private schema for protected trigger functions
-- ------------------------------------------------------------

create schema if not exists library_private;

revoke all
on schema library_private
from public, anon, authenticated;


-- ------------------------------------------------------------
-- 2. Append-only history table
-- ------------------------------------------------------------

create table if not exists
public.library_reader_book_state_history
(
  history_id bigint
    generated always as identity
    primary key,

  user_id uuid not null,

  reader_id text not null
    check (
      reader_id in ('cj', 'jc')
    ),

  catalog_key text not null,

  operation text not null
    check (
      operation in (
        'BASELINE',
        'INSERT',
        'UPDATE',
        'DELETE'
      )
    ),

  old_state jsonb,

  new_state jsonb,

  changed_at timestamptz
    not null
    default now(),

  changed_by uuid
);


-- Fast lookup for one reader/book's complete history.

create index if not exists
library_reader_book_state_history_lookup_idx
on public.library_reader_book_state_history
(
  user_id,
  reader_id,
  catalog_key,
  changed_at desc
);


-- Allow only one baseline snapshot per reader/book.

create unique index if not exists
library_reader_book_state_history_baseline_idx
on public.library_reader_book_state_history
(
  user_id,
  reader_id,
  catalog_key
)
where operation = 'BASELINE';


-- ------------------------------------------------------------
-- 3. RLS and browser privileges
-- ------------------------------------------------------------

alter table
public.library_reader_book_state_history
enable row level security;


-- Start from no browser access.

revoke all
on table
public.library_reader_book_state_history
from anon, authenticated;


-- The identity sequence should not be directly usable
-- by browser roles either.

revoke all
on sequence
public.library_reader_book_state_history_history_id_seq
from anon, authenticated;


-- Household browser may inspect history, but not change it.

grant select
on table
public.library_reader_book_state_history
to authenticated;


drop policy if exists
"Household can view reader state history"
on public.library_reader_book_state_history;


create policy
"Household can view reader state history"
on public.library_reader_book_state_history
for select
to authenticated
using
(
  (select auth.uid()) is not null

  and
  (select auth.uid()) = user_id

  and
  user_id =
    '2ffd4a75-0f05-41ca-bd69-fa035ee57e22'::uuid
);


-- Deliberately create no INSERT, UPDATE, or DELETE policies.


-- ------------------------------------------------------------
-- 4. Automatic state-history logger
-- ------------------------------------------------------------

create or replace function
library_private.log_library_reader_book_state_history()
returns trigger
language plpgsql
security definer
set search_path = pg_catalog
as $$
begin
  if TG_OP = 'INSERT' then
    insert into
    public.library_reader_book_state_history
    (
      user_id,
      reader_id,
      catalog_key,
      operation,
      old_state,
      new_state,
      changed_at,
      changed_by
    )
    values
    (
      NEW.user_id,
      NEW.reader_id,
      NEW.catalog_key,
      'INSERT',
      null,
      to_jsonb(NEW),
      clock_timestamp(),
      auth.uid()
    );

    return NEW;
  end if;


  if TG_OP = 'UPDATE' then
    insert into
    public.library_reader_book_state_history
    (
      user_id,
      reader_id,
      catalog_key,
      operation,
      old_state,
      new_state,
      changed_at,
      changed_by
    )
    values
    (
      NEW.user_id,
      NEW.reader_id,
      NEW.catalog_key,
      'UPDATE',
      to_jsonb(OLD),
      to_jsonb(NEW),
      clock_timestamp(),
      auth.uid()
    );

    return NEW;
  end if;


  if TG_OP = 'DELETE' then
    insert into
    public.library_reader_book_state_history
    (
      user_id,
      reader_id,
      catalog_key,
      operation,
      old_state,
      new_state,
      changed_at,
      changed_by
    )
    values
    (
      OLD.user_id,
      OLD.reader_id,
      OLD.catalog_key,
      'DELETE',
      to_jsonb(OLD),
      null,
      clock_timestamp(),
      auth.uid()
    );

    return OLD;
  end if;


  raise exception
    'Unsupported reader-state history operation: %',
    TG_OP;
end;
$$;


-- Nobody should call this function directly.
-- The database trigger invokes it automatically.

revoke all
on function
library_private.log_library_reader_book_state_history()
from public, anon, authenticated;


drop trigger if exists
audit_library_reader_book_state_changes
on public.library_reader_book_state;


create trigger
audit_library_reader_book_state_changes
after insert or update or delete
on public.library_reader_book_state
for each row
execute function
library_private.log_library_reader_book_state_history();


-- ------------------------------------------------------------
-- 5. Block changes to history itself
-- ------------------------------------------------------------

create or replace function
library_private.reject_library_reader_history_mutation()
returns trigger
language plpgsql
set search_path = pg_catalog
as $$
begin
  raise exception
    'library_reader_book_state_history is append-only';

  return null;
end;
$$;


revoke all
on function
library_private.reject_library_reader_history_mutation()
from public, anon, authenticated;


drop trigger if exists
protect_library_reader_book_state_history
on public.library_reader_book_state_history;


create trigger
protect_library_reader_book_state_history
before update or delete
on public.library_reader_book_state_history
for each row
execute function
library_private.reject_library_reader_history_mutation();


-- ------------------------------------------------------------
-- 6. Establish the current 523 rows as the baseline
-- ------------------------------------------------------------

insert into
public.library_reader_book_state_history
(
  user_id,
  reader_id,
  catalog_key,
  operation,
  old_state,
  new_state,
  changed_at,
  changed_by
)
select
  state.user_id,
  state.reader_id,
  state.catalog_key,
  'BASELINE',
  null,
  to_jsonb(state),
  clock_timestamp(),
  null

from public.library_reader_book_state
  as state

where not exists
(
  select 1

  from public.library_reader_book_state_history
    as history

  where
    history.operation = 'BASELINE'

    and
    history.user_id =
      state.user_id

    and
    history.reader_id =
      state.reader_id

    and
    history.catalog_key =
      state.catalog_key
)

on conflict do nothing;