-- ============================================================
-- MyLibrary 12 - Create Reading Timer Sessions
--
-- Creates stopwatch sessions for active reading attempts.
-- A reading attempt answers "which book am I reading?"
-- A timer session answers "how fast did this sitting go?"
-- ============================================================


create schema if not exists library_private;

revoke all
on schema library_private
from public, anon, authenticated;


create table if not exists
public.library_reader_timer_sessions
(
  timer_session_id uuid
    primary key
    default gen_random_uuid(),

  user_id uuid
    not null
    references auth.users(id)
    on delete cascade,

  reader_id text
    not null
    check (
      reader_id in ('cj', 'jc')
    ),

  attempt_id uuid
    references public.library_reader_reading_attempts(attempt_id)
    on delete set null,

  catalog_key text
    not null
    check (
      btrim(catalog_key) <> ''
    ),

  start_page integer
    not null
    check (
      start_page >= 0
    ),

  end_page integer
    check (
      end_page is null
      or end_page >= start_page
    ),

  started_at timestamptz
    not null
    default now(),

  stopped_at timestamptz,

  duration_seconds integer
    check (
      duration_seconds is null
      or duration_seconds > 0
    ),

  created_at timestamptz
    not null
    default now(),

  updated_at timestamptz
    not null
    default now(),

  constraint
  library_reader_timer_sessions_lifecycle_check
  check
  (
    (
      stopped_at is null
      and end_page is null
      and duration_seconds is null
    )

    or

    (
      stopped_at is not null
      and end_page is not null
      and duration_seconds is not null
      and stopped_at >= started_at
    )
  )
);


create unique index if not exists
library_reader_timer_sessions_one_active_idx
on public.library_reader_timer_sessions
(
  user_id,
  reader_id
)
where stopped_at is null;


create index if not exists
library_reader_timer_sessions_reader_lookup_idx
on public.library_reader_timer_sessions
(
  user_id,
  reader_id,
  started_at desc
);


create index if not exists
library_reader_timer_sessions_attempt_lookup_idx
on public.library_reader_timer_sessions
(
  attempt_id,
  started_at desc
);


alter table
public.library_reader_timer_sessions
enable row level security;


revoke all
on table
public.library_reader_timer_sessions
from anon, authenticated;


grant
  select,
  insert,
  update
on table
public.library_reader_timer_sessions
to authenticated;


