-- ============================================================
-- MyLibrary 97 - Verify Reader State History
-- ============================================================


-- 1. Baseline and change counts

select
  operation,
  count(*) as history_rows

from public.library_reader_book_state_history

group by operation
order by operation;


-- 2. Browser table privileges

select
  grantee,
  privilege_type

from information_schema.role_table_grants

where
  table_schema = 'public'

  and table_name =
    'library_reader_book_state_history'

  and grantee in (
    'anon',
    'authenticated'
  )

order by
  grantee,
  privilege_type;


-- 3. History-table RLS policies

select
  policyname,
  cmd,
  roles,
  qual,
  with_check

from pg_policies

where
  schemaname = 'public'

  and tablename =
    'library_reader_book_state_history';


-- 4. Relevant triggers

select
  trigger_name,
  event_object_table,
  action_timing,
  event_manipulation

from information_schema.triggers

where
  trigger_schema = 'public'

  and event_object_table in
  (
    'library_reader_book_state',
    'library_reader_book_state_history'
  )

order by
  event_object_table,
  trigger_name,
  event_manipulation;