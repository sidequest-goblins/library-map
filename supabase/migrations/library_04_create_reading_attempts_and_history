-- ------------------------------------------------------------
-- 11. Migrate meaningful legacy in-progress state
-- ------------------------------------------------------------
--
-- The existing permanent book-state table currently contains
-- one meaningful unread row with current_page > 0.
--
-- Preserve that progress as an active first-read attempt.
--
-- Read rows with a page total are deliberately NOT migrated:
-- those represented completed challenge books, not active reads.
--
-- The old current_page value remains temporarily because the
-- deployed app still reads it. It will be retired only after
-- the UI has switched safely to reading attempts.
-- ------------------------------------------------------------

insert into
public.library_reader_reading_attempts
(
  user_id,
  reader_id,
  catalog_key,
  current_page,
  started_at
)
select
  state.user_id,
  state.reader_id,
  state.catalog_key,
  state.current_page,

  coalesce(
    state.updated_at,
    state.created_at,
    clock_timestamp()
  )

from
public.library_reader_book_state
  as state

where
  state.is_read = false

  and
  coalesce(
    state.current_page,
    0
  ) > 0

  and not exists
  (
    select 1

    from
    public.library_reader_reading_attempts
      as existing_attempt

    where
      existing_attempt.user_id =
        state.user_id

      and
      existing_attempt.reader_id =
        state.reader_id

      and
      existing_attempt.catalog_key =
        state.catalog_key

      and
      existing_attempt.status =
        'active'
  )

on conflict do nothing;