-- ------------------------------------------------------------
-- 6. Prepare and protect attempt lifecycle
-- ------------------------------------------------------------

create or replace function
library_private.prepare_library_reader_reading_attempt()
returns trigger
language plpgsql
security definer
set search_path = pg_catalog
as $$
declare
  prior_read_exists boolean;
begin
  -- ----------------------------------------------------------
  -- New attempts
  -- ----------------------------------------------------------

  if TG_OP = 'INSERT' then
    if
      NEW.catalog_key is null
      or btrim(NEW.catalog_key) = ''
    then
      raise exception
        'A reading attempt requires a catalog key';
    end if;


    NEW.catalog_key :=
      btrim(NEW.catalog_key);


    -- Every new attempt begins active.
    --
    -- Completion and abandonment must happen through
    -- a later explicit update.

    NEW.status := 'active';
    NEW.completed_at := null;
    NEW.abandoned_at := null;


    NEW.started_at :=
      coalesce(
        NEW.started_at,
        clock_timestamp()
      );


    NEW.created_at :=
      coalesce(
        NEW.created_at,
        clock_timestamp()
      );


    NEW.updated_at :=
      NEW.created_at;


    -- An attempt is a reread when either:
    --
    --   1. The permanent reader/book state is already Read, or
    --   2. A prior completed attempt exists.
    --
    -- An abandoned first attempt does not turn the next attempt
    -- into a reread unless the book was actually completed.

    select
    (
      exists
      (
        select 1

        from
        public.library_reader_book_state
          as state

        where
          state.user_id =
            NEW.user_id

          and
          state.reader_id =
            NEW.reader_id

          and
          state.catalog_key =
            NEW.catalog_key

          and
          state.is_read = true
      )

      or

      exists
      (
        select 1

        from
        public.library_reader_reading_attempts
          as prior_attempt

        where
          prior_attempt.user_id =
            NEW.user_id

          and
          prior_attempt.reader_id =
            NEW.reader_id

          and
          prior_attempt.catalog_key =
            NEW.catalog_key

          and
          prior_attempt.status =
            'completed'
      )
    )
    into prior_read_exists;


    NEW.is_reread :=
      prior_read_exists;


    return NEW;
  end if;


  -- ----------------------------------------------------------
  -- Existing attempts
  -- ----------------------------------------------------------

  if TG_OP = 'UPDATE' then
    -- Identity and historical classification never change.

    if
      NEW.attempt_id
        is distinct from
      OLD.attempt_id

      or

      NEW.user_id
        is distinct from
      OLD.user_id

      or

      NEW.reader_id
        is distinct from
      OLD.reader_id

      or

      NEW.catalog_key
        is distinct from
      OLD.catalog_key

      or

      NEW.is_reread
        is distinct from
      OLD.is_reread

      or

      NEW.started_at
        is distinct from
      OLD.started_at

      or

      NEW.created_at
        is distinct from
      OLD.created_at
    then
      raise exception
        'Reading attempt identity and classification are immutable';
    end if;


    -- Once an attempt is completed or abandoned, it becomes
    -- a frozen historical record.

    if OLD.status <> 'active' then
      raise exception
        'Completed and abandoned reading attempts are immutable';
    end if;


    if NEW.status = 'active' then
      NEW.completed_at := null;
      NEW.abandoned_at := null;


    elsif NEW.status = 'completed' then
      NEW.completed_at :=
        coalesce(
          NEW.completed_at,
          clock_timestamp()
        );

      NEW.abandoned_at := null;


    elsif NEW.status = 'abandoned' then
      NEW.abandoned_at :=
        coalesce(
          NEW.abandoned_at,
          clock_timestamp()
        );

      NEW.completed_at := null;


    else
      raise exception
        'Unsupported reading attempt status: %',
        NEW.status;
    end if;


    NEW.updated_at :=
      clock_timestamp();


    return NEW;
  end if;


  raise exception
    'Unsupported reading attempt operation: %',
    TG_OP;
end;
$$;


revoke all
on function
library_private.prepare_library_reader_reading_attempt()
from public, anon, authenticated;


drop trigger if exists
prepare_library_reader_reading_attempt
on public.library_reader_reading_attempts;


create trigger
prepare_library_reader_reading_attempt
before insert or update
on public.library_reader_reading_attempts
for each row
execute function
library_private.prepare_library_reader_reading_attempt();


