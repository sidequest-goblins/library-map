-- ============================================================
-- MyLibrary 04 - Create Reading Attempts and History
--
-- Creates:
--   1. Global reading attempts, independent of Challenges.
--   2. First-read versus reread classification.
--   3. One active attempt per reader/book.
--   4. Immutable completed and abandoned attempts.
--   5. Automatic book-state completion sync.
--   6. Append-only attempt history.
--   7. Migration of legacy in-progress book state.
--
-- Browser permissions:
--   Attempts:
--     authenticated household user: SELECT, INSERT, UPDATE
--     anon: no access
--     DELETE: prohibited
--
--   Attempt history:
--     authenticated household user: SELECT only
--     anon: no access
--     INSERT / UPDATE / DELETE: prohibited
-- ============================================================


-- ------------------------------------------------------------
-- 1. Private schema
-- ------------------------------------------------------------

create schema if not exists library_private;

revoke all
on schema library_private
from public, anon, authenticated;


-- ------------------------------------------------------------
-- 2. Reading attempts
-- ------------------------------------------------------------

create table if not exists
public.library_reader_reading_attempts
(
  attempt_id uuid
    primary key
    default gen_random_uuid(),

  user_id uuid
    not null
    references auth.users(id)
    on delete cascade,

  reader_id text
    not null
    check (
      reader_id in ('cj', 'jc')
    ),

  catalog_key text
    not null
    check (
      btrim(catalog_key) <> ''
    ),

  status text
    not null
    default 'active'
    check (
      status in (
        'active',
        'completed',
        'abandoned'
      )
    ),

  is_reread boolean
    not null
    default false,

  current_page integer
    check (
      current_page is null
      or current_page >= 0
    ),

  started_at timestamptz
    not null
    default now(),

  completed_at timestamptz,

  abandoned_at timestamptz,

  created_at timestamptz
    not null
    default now(),

  updated_at timestamptz
    not null
    default now(),

  constraint
  library_reader_reading_attempts_lifecycle_check
  check
  (
    (
      status = 'active'
      and completed_at is null
      and abandoned_at is null
    )

    or

    (
      status = 'completed'
      and completed_at is not null
      and abandoned_at is null
      and completed_at >= started_at
    )

    or

    (
      status = 'abandoned'
      and abandoned_at is not null
      and completed_at is null
      and abandoned_at >= started_at
    )
  )
);


-- Only one active attempt may exist for one
-- user + reader + book combination.
--
-- Completed and abandoned attempts are not included
-- in this unique index, so their history is unlimited.

create unique index if not exists
library_reader_reading_attempts_one_active_idx
on public.library_reader_reading_attempts
(
  user_id,
  reader_id,
  catalog_key
)
where status = 'active';


-- Fast lookup of a reader's attempts for one book.

create index if not exists
library_reader_reading_attempts_book_lookup_idx
on public.library_reader_reading_attempts
(
  user_id,
  reader_id,
  catalog_key,
  started_at desc
);


-- Fast lookup of all active household attempts.

create index if not exists
library_reader_reading_attempts_active_lookup_idx
on public.library_reader_reading_attempts
(
  user_id,
  reader_id,
  updated_at desc
)
where status = 'active';


-- ------------------------------------------------------------
-- 3. Attempt history
-- ------------------------------------------------------------

create table if not exists
public.library_reader_reading_attempt_history
(
  history_id bigint
    generated always as identity
    primary key,

  attempt_id uuid
    not null,

  user_id uuid
    not null,

  reader_id text
    not null
    check (
      reader_id in ('cj', 'jc')
    ),

  catalog_key text
    not null,

  operation text
    not null
    check (
      operation in (
        'INSERT',
        'UPDATE'
      )
    ),

  old_state jsonb,

  new_state jsonb
    not null,

  changed_at timestamptz
    not null
    default now(),

  changed_by uuid,

  constraint
  library_reader_reading_attempt_history_shape_check
  check
  (
    (
      operation = 'INSERT'
      and old_state is null
      and new_state is not null
    )

    or

    (
      operation = 'UPDATE'
      and old_state is not null
      and new_state is not null
    )
  )
);


create index if not exists
library_reader_reading_attempt_history_lookup_idx
on public.library_reader_reading_attempt_history
(
  user_id,
  reader_id,
  catalog_key,
  changed_at desc
);


create index if not exists
library_reader_reading_attempt_history_attempt_idx
on public.library_reader_reading_attempt_history
(
  attempt_id,
  history_id
);


