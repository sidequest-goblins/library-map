-- 7. Prevent attempt deletion
-- ------------------------------------------------------------

create or replace function
library_private.reject_library_reader_reading_attempt_delete()
returns trigger
language plpgsql
set search_path = pg_catalog
as $$
begin
  raise exception
    'Reading attempts cannot be deleted; complete or abandon the active attempt instead';

  return null;
end;
$$;


revoke all
on function
library_private.reject_library_reader_reading_attempt_delete()
from public, anon, authenticated;


drop trigger if exists
protect_library_reader_reading_attempt_delete
on public.library_reader_reading_attempts;


create trigger
protect_library_reader_reading_attempt_delete
before delete
on public.library_reader_reading_attempts
for each row
execute function
library_private.reject_library_reader_reading_attempt_delete();


-- ------------------------------------------------------------
-- 8. Attempt audit logger
-- ------------------------------------------------------------

create or replace function
library_private.log_library_reader_reading_attempt_history()
returns trigger
language plpgsql
security definer
set search_path = pg_catalog
as $$
begin
  if TG_OP = 'INSERT' then
    insert into
    public.library_reader_reading_attempt_history
    (
      attempt_id,
      user_id,
      reader_id,
      catalog_key,
      operation,
      old_state,
      new_state,
      changed_at,
      changed_by
    )
    values
    (
      NEW.attempt_id,
      NEW.user_id,
      NEW.reader_id,
      NEW.catalog_key,
      'INSERT',
      null,
      to_jsonb(NEW),
      clock_timestamp(),
      auth.uid()
    );


    return NEW;
  end if;


  if TG_OP = 'UPDATE' then
    insert into
    public.library_reader_reading_attempt_history
    (
      attempt_id,
      user_id,
      reader_id,
      catalog_key,
      operation,
      old_state,
      new_state,
      changed_at,
      changed_by
    )
    values
    (
      NEW.attempt_id,
      NEW.user_id,
      NEW.reader_id,
      NEW.catalog_key,
      'UPDATE',
      to_jsonb(OLD),
      to_jsonb(NEW),
      clock_timestamp(),
      auth.uid()
    );


    return NEW;
  end if;


  raise exception
    'Unsupported reading attempt history operation: %',
    TG_OP;
end;
$$;


revoke all
on function
library_private.log_library_reader_reading_attempt_history()
from public, anon, authenticated;


drop trigger if exists
audit_library_reader_reading_attempt_changes
on public.library_reader_reading_attempts;


create trigger
audit_library_reader_reading_attempt_changes
after insert or update
on public.library_reader_reading_attempts
for each row
execute function
library_private.log_library_reader_reading_attempt_history();


-- ------------------------------------------------------------
-- 9. Completing an attempt permanently marks the book Read
-- ------------------------------------------------------------

create or replace function
library_private.sync_completed_reading_attempt_to_book_state()
returns trigger
language plpgsql
security definer
set search_path = pg_catalog
as $$
begin
  if
    NEW.status = 'completed'
    and OLD.status is distinct from 'completed'
  then
    insert into
    public.library_reader_book_state
      as existing_state
    (
      user_id,
      reader_id,
      catalog_key,
      is_read,
      current_page,
      rating,
      notes
    )
    values
    (
      NEW.user_id,
      NEW.reader_id,
      NEW.catalog_key,
      true,
      null,
      null,
      null
    )

    on conflict
    (
      user_id,
      reader_id,
      catalog_key
    )
    do update

    set
      is_read = true

    where
      existing_state.is_read
        is distinct from
      true;
  end if;


  return NEW;
end;
$$;


revoke all
on function
library_private.sync_completed_reading_attempt_to_book_state()
from public, anon, authenticated;


drop trigger if exists
sync_completed_library_reader_reading_attempt
on public.library_reader_reading_attempts;


create trigger
sync_completed_library_reader_reading_attempt
after update
on public.library_reader_reading_attempts
for each row
execute function
library_private.sync_completed_reading_attempt_to_book_state();


